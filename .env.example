# TDX credentials: https://tdx.transportdata.tw/user/dataservice/key
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Comma-separated browser origins allowed to call the backend.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174

# Geoapify Geocoding API: https://myprojects.geoapify.com/
GEOAPIFY_API_KEY=

# Gemini API key for the AI route assistant: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional shared cache. Leave blank to use the in-process memory cache.
REDIS_URL=
CACHE_NAMESPACE=roadmap:v1

# Development-only operational counters. Disabled by default.
ENABLE_SYSTEM_STATS=false
