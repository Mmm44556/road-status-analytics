# TDX credentials: https://tdx.transportdata.tw/user/dataservice/key
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Comma-separated browser origins allowed to call the backend.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional overrides for National Police Agency batch datasets.
# A2 resources rotate as new half-month archives are published.
ENV_A1_JSON_URL=
ENV_A2_ZIP_URL=
ENV_A3_JSON_URL=
